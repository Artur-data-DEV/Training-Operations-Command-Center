{
    "compilerOptions": {
        "target": "ES6",
        "lib": [
            "DOM",
            "ES6"
        ],
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "noEmitHelpers": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "types": [
            "@servicenow/glide"
        ]
    },
    "include": [
        "./**/*.client.js",
        "../@types/servicenow/*.client.d.ts"
    ]
}
