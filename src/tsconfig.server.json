{
    "compilerOptions": {
        "lib": [
            "ES2021"
        ],
        "noEmit": true,
        "checkJs": true,
        "allowJs": true,
        "noEmitHelpers": true,
        "module": "node16",
        "moduleResolution": "node16",
        "skipLibCheck": true,
        "types": [
            "@servicenow/glide"
        ]
    },
    "include": [
        "./**/*.server.js",
        "../@types/servicenow/*.server.d.ts"
    ]
}   
